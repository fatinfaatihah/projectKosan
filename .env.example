# ==========================================================
# KONFIGURASI SUPABASE & APLIKASI KOSTPUTRIWINDA
# ==========================================================
# Dapatkan Project URL dan anon / publishable key dari:
# Supabase Dashboard -> Project Settings -> API
# PENTING: JANGAN PERNAH memasukkan service_role key ke file ini!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Nomor WhatsApp Pemilik Kos (format angka 628xxxxxxxxxx tanpa spasi atau tanda +)
# Digunakan untuk tombol WhatsApp publik dan calon penyewa mengonfirmasi pesanan
VITE_OWNER_WHATSAPP=6281234567890
